# Google OAuth web client (docs/deployment.md#google-sign-in). The redirect URI
# registered with Google is ${PUBLIC_BASE_URL}/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Postgres connection string of the privileged role the server connects as
# (Supabase: the pooler or direct connection string). Server-side only. The
# schema is in supabase/migrations, applied with the Supabase CLI.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Key (32 bytes, base64 or hex; `openssl rand -base64 32`) encrypting stored
# passkey credentials. Required once any credential exists; never stored in the
# database.
CREDENTIALS_ENCRYPTION_KEY=
# The user the iCloud Reminders sync, the single-user file import and the pnpm
# scripts act for. Required when the Reminders sync is enabled.
REMINDERS_OWNER_EMAIL=
# Origin the server is reached at, without a path.
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated redirect URIs API clients may pass to /auth/start, matched
# exactly. Defaults to the iOS app's; add the Chrome extension's
# https://<extension-id>.chromiumapp.org/ to sign it in.
ALLOWED_CLIENT_REDIRECTS=dev.willsawyerrrr.personalshopper://auth

# Optional overrides
PORT=3000
# fatal, error, warn, info, debug, trace or silent. `debug` also logs /healthz checks.
LOG_LEVEL=info
# Set to `true` behind a reverse proxy so rate limiting uses X-Forwarded-For.
TRUST_PROXY=false
# Files of an earlier single-user deployment. Each one found at startup is
# imported into the owner's rows, then renamed with an `.imported` suffix.
ITEMS_PATH=items.yml
TOKEN_STORE_PATH=tokens.json
SESSION_PATH=session.json
PASSKEY_CREDENTIALS_PATH=passkey-credentials.json
# Abuse limits for open sign-up (defaults shown).
# Total users; new Google accounts beyond this cannot sign up.
MAX_USERS=50
MAX_ITEMS_PER_USER=200
# Unexpired tokens (sign-ins) per user.
MAX_TOKENS_PER_USER=20
# Authenticated requests per minute per user on /admin and /cart.
USER_RATE_LIMIT_PER_MINUTE=120
# Requests per minute per client IP on each /auth/* route and POST /cart/items.
IP_RATE_LIMIT_PER_MINUTE=30
# Heartbeat refresh interval keeping the Woolworths login alive; 0 disables.
SESSION_KEEPALIVE_INTERVAL_MS=21600000

# Reminders offline-queue sync — set both to enable, leave blank to disable.
# ICLOUD_APP_SPECIFIC_PASSWORD is generated at appleid.apple.com, not your
# actual Apple ID password. See docs/architecture.md.
ICLOUD_USERNAME=
ICLOUD_APP_SPECIFIC_PASSWORD=
REMINDERS_LIST_NAME=Shopping List
REMINDERS_SYNC_INTERVAL_MS=300000
