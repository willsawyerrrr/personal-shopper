# Bearer token the /items webhook requires — generate with `openssl rand -hex 32`
SHARED_SECRET=

# Optional overrides
PORT=3000
# fatal, error, warn, info, debug, trace or silent. `debug` also logs /healthz checks.
LOG_LEVEL=info
# Set to `true` behind a reverse proxy so rate limiting uses X-Forwarded-For.
TRUST_PROXY=false
ITEMS_PATH=items.yml
SESSION_PATH=session.json
# Passkey credential saved by `pnpm register-passkey`. When the file exists the
# server signs in over HTTP (no browser needed) if the heartbeat refresh
# is rejected; when absent an expired session just fails until re-captured.
PASSKEY_CREDENTIALS_PATH=passkey-credentials.json
# Heartbeat refresh interval keeping the Woolworths login alive; 0 disables.
SESSION_KEEPALIVE_INTERVAL_MS=21600000

# Reminders offline-queue sync — set both to enable, leave blank to disable.
# ICLOUD_APP_SPECIFIC_PASSWORD is generated at appleid.apple.com, not your
# actual Apple ID password. See docs/architecture.md.
ICLOUD_USERNAME=
ICLOUD_APP_SPECIFIC_PASSWORD=
REMINDERS_LIST_NAME=Shopping List
REMINDERS_SYNC_INTERVAL_MS=300000
