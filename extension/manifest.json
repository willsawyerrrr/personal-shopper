{
  "manifest_version": 3,
  "key": "",
  "name": "Personal Shopper — Add Item",
  "version": "1.0.0",
  "description": "Adds the current Woolworths product page to your personal-shopper items list.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to Personal Shopper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "debugger", "identity", "storage"],
  "host_permissions": ["https://*.willsawyerrrr.dev/*", "https://*.woolworths.com.au/*"],
  "content_scripts": [
    {
      "matches": ["https://personal-shopper.willsawyerrrr.dev/*"],
      "js": ["web-app.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Add to Personal Shopper"
    }
  }
}
