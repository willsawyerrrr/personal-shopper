{
  "name": "personal-shopper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "\"$HOME/willsawyerrrr.dev/platform/main/scripts/load-env\" \"$HOME/willsawyerrrr.dev/.env\" \"$HOME/willsawyerrrr.dev/.env.apple\" \"$HOME/willsawyerrrr.dev/personal-shopper/.env\" -- node dist/src/server.js",
    "dev": "\"$HOME/willsawyerrrr.dev/platform/main/scripts/load-env\" \"$HOME/willsawyerrrr.dev/.env\" \"$HOME/willsawyerrrr.dev/.env.apple\" \"$HOME/willsawyerrrr.dev/personal-shopper/.env\" -- tsx watch src/server.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package-extension": "tsx scripts/package-extension.ts",
    "capture-session": "tsx scripts/capture-session.ts",
    "passkey-login": "tsx scripts/passkey-login.ts",
    "register-passkey": "tsx scripts/register-passkey.ts",
    "search-product": "tsx scripts/search-product.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "tsdav": "^2.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
