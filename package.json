{
  "name": "personal-shopper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/src/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package-extension": "tsx scripts/package-extension.ts",
    "capture-session": "tsx scripts/capture-session.ts",
    "passkey-login": "tsx scripts/passkey-login.ts",
    "register-passkey": "tsx scripts/register-passkey.ts",
    "search-product": "tsx scripts/search-product.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "tsdav": "^2.3.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
